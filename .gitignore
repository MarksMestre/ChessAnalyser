# ---------------------------------------------------------------------------
# Ignore texts
# ---------------------------------------------------------------------------
tests
test
tests/*
test/*


# ---------------------------------------------------------------------------
# Secrets — never commit these
# ---------------------------------------------------------------------------
api.txt
api_*.txt
api-*.txt
.env
.env.*
*.key
*.pem
*.p12
*.pfx
credentials*.json
secrets*.json
secrets*.txt

# Username behind `--player me` (see player.py). Personal, so never committed.
player.txt

# process_api/ holds api.txt (your API key). The whole directory is ignored so
# a future key drop-in cannot slip through.
process_api/

# ---------------------------------------------------------------------------
# Engines and models — ~1 GB of third-party binaries, all re-downloadable.
# `python setup.py` puts every one of these back and verifies the install.
#   StockFish : github.com/official-stockfish/Stockfish -> engines\stockfish\
#   Lc0       : github.com/LeelaChessZero/lc0           -> engines\lc0-gpu\
#   Lc0 nets  : lczero.org/play/networks/bestnets/       -> data\nets\
# ---------------------------------------------------------------------------
engines/
data/nets/

# Opening book — CC0 TSVs from lichess-org/chess-openings, fetched
# automatically by openings.ensure_book(). Keep the repo free of vendored data.
data/openings/

# Belt and braces, in case an engine or net is dropped somewhere else.
stockfish.exe
stockfish
lc0.exe
lc0
*.nnue
*.nnue.embedded
*.pb
*.pb.gz
*.onnx

